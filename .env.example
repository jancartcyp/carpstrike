# CarpStrike — variables d'environnement
# Copier en .env.local (dev) et renseigner dans Vercel (Production/Preview).
# NE JAMAIS committer les vraies valeurs.

# ── Supabase ──
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<clé anon publique>
# Service role : STRICTEMENT serveur (upload photos, sert aussi de clé de signature
# du cookie commissaire). Ne jamais exposer côté client.
SUPABASE_SERVICE_ROLE_KEY=<clé service_role>

# Secret de signature du cookie de session commissaire.
# Optionnel : si absent, on retombe sur SUPABASE_SERVICE_ROLE_KEY.
# Recommandé en prod : une valeur dédiée et stable (ex. `openssl rand -hex 32`).
COMMISSAIRE_SESSION_SECRET=

# ── Base de données (Prisma) ──
# Utiliser le POOLER Supabase (port 5432, session) :
# postgresql://postgres.<ref>:<mot_de_passe>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# ── Différé (lancement gratuit) — non requis pour l'instant ──
# Paiements Stripe (Phase paiements) :
# STRIPE_SECRET_KEY=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Emails Resend (Phase emails) :
# RESEND_API_KEY=
